# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Custom diff drivers
*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary

# Export ignores (Excluded from git archive / production zip)
/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore